# Exclude everything
/*

# Local copy-into-OBS helper
/easy.bat

# Project files
!/.github
!/build-aux
!/cmake
!/data
!/docs
!/src
!/tests
!/SAMHUDTraining
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Docs and planning
!/docs/**
!/tests/**
!/SAMHUDTraining/**
/SAMHUDTraining/weights/
/SAMHUDTraining/**/__pycache__/
!/.github/**

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# MobileSAM weights and ONNX Runtime binaries (fetched, not vendored)
/data/models/*.onnx
!/data/models/mobilesam.encoder.onnx
!/data/models/mobilesam.decoder.onnx
/third_party/onnxruntime/*.dll
