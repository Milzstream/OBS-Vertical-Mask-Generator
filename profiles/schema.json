{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Milzstream/OBS-Vertical-Mask-Generator/profiles/schema.json",
  "title": "HUD Mask game profile",
  "type": "object",
  "required": ["schemaVersion", "game", "slots"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "game": { "type": "string" },
    "variant": { "type": "string", "default": "default" },
    "sourceHint": { "type": "string" },
    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "slots": {
      "type": "array",
      "items": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["id", "crop"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "crop": {
          "type": "object",
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": { "type": "integer", "minimum": 0 },
            "top": { "type": "integer", "minimum": 0 },
            "right": { "type": "integer", "minimum": 0 },
            "bottom": { "type": "integer", "minimum": 0 }
          }
        },
        "mask": {
          "type": "object",
          "properties": {
            "type": { "enum": ["png", "generated"] },
            "file": { "type": "string" }
          }
        },
        "presence": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["off", "probe", "template"] },
            "hideThreshold": { "type": "number" },
            "showThreshold": { "type": "number" },
            "holdMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
